#!/usr/bin/env php
<?php

declare(strict_types=1);

// Turns this template into a new bundle. See "Using this template" in README.md.

const DESCRIPTION_TOKEN = 'Starter template for msstc4symfony Symfony bundles';
// The lock legitimately names third-party packages (roave/security-advisories conflicts).
const LEFTOVER_SCAN_SKIP = 'composer-ci.lock';
const INIT_ONLY_FILES = ['bin/init', 'tests/Integration/InitScriptTest.php'];

function fail(string $message): never
{
    fwrite(STDERR, $message . PHP_EOL);
    exit(1);
}

function abort(string $message): never
{
    fail($message . PHP_EOL . 'The tree is partially initialised; restore it with `git reset --hard && git clean -fd`.');
}

function replaceOrAbort(string $pattern, string $file): string
{
    $content = file_get_contents($file);
    $result = $content === false ? null : preg_replace($pattern, '', $content);
    if ($result === null) {
        abort('Cannot rewrite ' . $file . ' (' . preg_last_error_msg() . ').');
    }

    return $result;
}

/**
 * @return list<string>
 */
function run(string $command, bool $mutating = true): array
{
    exec($command . ' 2>&1', $output, $code);
    if ($code !== 0) {
        ($mutating ? abort(...) : fail(...))($command . ' failed:' . PHP_EOL . implode(PHP_EOL, $output));
    }

    return array_values(array_filter($output, static fn (string $line): bool => $line !== ''));
}

/**
 * @param non-empty-list<string> $command
 *
 * @return list<string>
 */
function listFiles(array $command, bool $mutating = true): array
{
    // exec() splits output into lines and strips trailing whitespace, which mangles NUL-separated paths.
    $process = proc_open($command, [1 => ['pipe', 'w'], 2 => STDERR], $pipes);
    $raw = false;
    if ($process !== false) {
        $raw = stream_get_contents($pipes[1]);
        fclose($pipes[1]);
    }
    if ($process === false || proc_close($process) !== 0 || $raw === false) {
        ($mutating ? abort(...) : fail(...))(implode(' ', $command) . ' failed.');
    }

    return array_values(array_filter(explode("\0", $raw), static fn (string $path): bool => $path !== ''));
}

function jsonFragment(string $value): string
{
    return substr(json_encode($value, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), 1, -1);
}

$name = $argv[1] ?? '';
$description = trim($argv[2] ?? '');

if (preg_match('/^[A-Z][A-Za-z0-9]*$/', $name) !== 1 || str_ends_with($name, 'Bundle')) {
    fail('Usage: php bin/init <Name> "<description>" — <Name> is PascalCase without the "Bundle" suffix, e.g. OutboxInbox.');
}
if ($description === '' || preg_match('/[\x00-\x1F\x7F]/', $description) === 1) {
    fail('The description must be a non-empty single line.');
}
if (preg_match('//u', $description) !== 1) {
    fail('The description must be valid UTF-8.');
}
if (stripos($name . ' ' . $description, 'skeleton') !== false) {
    fail('The name and description must not contain the template word "skeleton"; it would survive the rename.');
}

chdir(dirname(__DIR__));
if (run('git status --porcelain', false) !== []) {
    fail('The working tree has uncommitted changes; commit or stash them first.');
}

// HTTPClient → HTTP, Client; OutboxInbox → Outbox, Inbox.
$words = preg_split('/(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])/', $name);
if ($words === false) {
    $words = [$name];
}
$kebab = strtolower(implode('-', $words));
$snake = strtolower(implode('_', $words));

$names = [
    'SkeletonBundle' => $name . 'Bundle',
    'skeleton-bundle' => $kebab . '-bundle',
    'msstc4symfony_skeleton' => 'msstc4symfony_' . $snake,
];

foreach (listFiles(['git', 'ls-files', '-z'], false) as $file) {
    if (in_array($file, INIT_ONLY_FILES, true)) {
        continue;
    }
    $content = file_get_contents($file);
    if ($content === false) {
        abort('Cannot read ' . $file);
    }
    // strtr() replaces the longest token first and never re-scans replaced text.
    $replacements = $names + [DESCRIPTION_TOKEN => str_ends_with($file, '.json') ? jsonFragment($description) : $description];
    file_put_contents($file, strtr($content, $replacements));

    $target = strtr($file, $names);
    if ($target !== $file) {
        run('git mv ' . escapeshellarg($file) . ' ' . escapeshellarg($target));
    }
}

file_put_contents('CHANGELOG.md', "# Changelog\n\n## Unreleased\n");
file_put_contents('README.md', replaceOrAbort('/<!-- init:start -->.*?<!-- init:end -->\n\n?/s', 'README.md'));
$workflow = '.github/workflows/checks.yml';
file_put_contents($workflow, rtrim(replaceOrAbort('/^[ \t]*# init:start\n.*?^[ \t]*# init:end\n/ms', $workflow)) . "\n");
run('git rm -q ' . implode(' ', array_map(escapeshellarg(...), INIT_ONLY_FILES)));

$lockCommand = 'COMPOSER=composer-ci.json composer update --lock --no-install --no-interaction';
exec('command -v composer', $ignored, $composerLookupExit);
if ($composerLookupExit === 0) {
    run($lockCommand);
} else {
    echo 'composer is not in PATH; run: ' . $lockCommand . PHP_EOL;
}

$leftovers = [];
foreach (listFiles(['git', 'ls-files', '-z', '-co', '--exclude-standard']) as $file) {
    if ($file === LEFTOVER_SCAN_SKIP) {
        continue;
    }
    if (stripos($file, 'skeleton') !== false || stripos((string) file_get_contents($file), 'skeleton') !== false) {
        $leftovers[] = $file;
    }
}
if ($leftovers !== []) {
    abort('Still mentions the template:' . PHP_EOL . implode(PHP_EOL, $leftovers));
}

echo sprintf('Initialised msstc4symfony/%s-bundle. Review `git diff`, then `git add -A && git commit -m "init commit"`.', $kebab) . PHP_EOL;
