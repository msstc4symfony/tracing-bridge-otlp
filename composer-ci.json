{
  "name": "msstc4symfony/skeleton-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Maxim Shamaev",
      "email": "maxim.shamaev@gmail.com"
    }
  ],
  "type": "symfony-bundle",
  "description": "Starter template for msstc4symfony Symfony bundles (CI profile — CI-only tools)",
  "minimum-stability": "stable",
  "keywords": [
    "php",
    "symfony"
  ],
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Msstc4Symfony\\SkeletonBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Msstc4Symfony\\SkeletonBundle\\Test\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.2",
    "composer-runtime-api": ">=2.2",
    "symfony/config": "^7.4|^8.0",
    "symfony/dependency-injection": "^7.4|^8.0",
    "symfony/http-kernel": "^7.4|^8.0"
  },
  "require-dev": {
    "deptrac/deptrac": "^4.6",
    "friendsofphp/php-cs-fixer": "^3.76",
    "infection/infection": "^0.32",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": ">=11.0",
    "rector/rector": "^2.1",
    "roave/backward-compatibility-check": "^8.20",
    "roave/security-advisories": "dev-latest"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "conflict": {
    "symfony/error-handler": "<7.4.17 || >=8.0,<8.1.5",
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "^7.4|^8.0"
    }
  }
}
